 "lines": [
  {
   "key": "ab_title",
   "who": "abu_rashid",
   "text": "روح الشارع."
  },
  {
   "key": "ab_intro_1",
   "who": "abu_rashid",
   "text": "هلا فيك يا ولدي. هذي سلوى... وهذا الشاهين. أول سيارة تعلمت عليها التقحيص."
  },
  {
   "key": "ab_intro_2",
   "who": "abu_rashid",
   "text": "الكويت مو بس مدينة... الشارع هني له روح. وروح الشارع ما تنشرى... تنكسب."
  },
  {
   "key": "ab_tut_throttle",
   "who": "abu_rashid",
   "text": "دوس البانزين... خل التيربو يصفّر."
  },
  {
   "key": "ab_tut_handbrake",
   "who": "abu_rashid",
   "text": "الحين! شد الهاندبريك وخل الصدر يلف... لا تخاف."
  },
  {
   "key": "ab_tut_counter",
   "who": "abu_rashid",
   "text": "عاكس الدركسون... إي، جذي. لا تفك الدعسة."
  },
  {
   "key": "ab_good",
   "who": "abu_rashid",
   "text": "كفو! هذا التقحيص اللي أبيه."
  },
  {
   "key": "ab_fail",
   "who": "abu_rashid",
   "text": "هدّيت بدري... الدعسة لازم تكمل للنهاية."
  },
  {
   "key": "ab_garage",
   "who": "abu_rashid",
   "text": "حياك بالكراج. كل سيارة هني لها قصة."
  },
  {
   "key": "ab_abusitta",
   "who": "abu_rashid",
   "text": "أبو ستة... هذي سيارتي. سنة أربعة وثمانين أخذت فيها لقب الشارع."
  },
  {
   "key": "cl_kafu",
   "who": "mishari",
   "text": "كفو!"
  },
  {
   "key": "cl_yasalam",
   "who": "mishari",
   "text": "يا سلااام!"
  },
  {
   "key": "cl_adel",
   "who": "mishari",
   "text": "عدل عدل!"
  },
  {
   "key": "cl_mumtaz",
   "who": "mishari",
   "text": "تقحيص ممتاز!"
  },
  {
   "key": "cl_wahsh",
   "who": "mishari",
   "text": "وحش!"
  },
  {
   "key": "cl_khateer",
   "who": "mishari",
   "text": "خطيير!"
  },
  {
   "key": "cl_qarrib",
   "who": "mishari",
   "text": "قرّب أكثر!"
  },
  {
   "key": "mi_taunt",
   "who": "mishari",
   "text": "شنو هالتقحيص؟ تعال الرميثية وأوريك شلون يصير."
  },
  {
   "key": "no_paint",
   "who": "noura",
   "text": "جيبها المحل... عندي لك ألوان ما شفتها بحياتك."
  },
  {
   "key": "rd_spotted",
   "who": "radio",
   "radio": true,
   "text": "دورية اثنعش للعمليات... عندنا سيارة فضية تقحص عند دوار سلوى. متابعين."
  },
  {
   "key": "rd_ahead",
   "who": "radio",
   "radio": true,
   "text": "السيارة الفضية قدامنا... انتبه... انتبه."
  },
  {
   "key": "rd_block",
   "who": "radio",
   "radio": true,
   "text": "العمليات: سكّروا الدوار الثاني. لا تخلونه يطلع."
  },
  {
   "key": "rd_lost",
   "who": "radio",
   "radio": true,
   "text": "فقدناه... ما في أثر للسيارة. نرجع للدورية."
  },
  {
   "key": "pa_stop",
   "who": "radio",
   "radio": true,
   "text": "السيارة الفضية! وقّف على اليمين!"
  }
 ]
